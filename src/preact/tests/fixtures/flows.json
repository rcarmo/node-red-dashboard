  {
    "id": "linkHubRouter",
    "z": "f100000000000003",
    "type": "switch",
    "name": "Route by topic",
    "property": "topic",
    "propertyType": "msg",
    "rules": [
      {"t": "eq", "v": "gauge", "vt": "str"},
      {"t": "eq", "v": "toast", "vt": "str"},
      {"t": "eq", "v": "echo", "vt": "str"},
      {"t": "eq", "v": "series", "vt": "str"},
      {"t": "else"}
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 5,
    "x": 330,
    "y": 300,
    "wires": [
      ["gaugeNode"],
      ["linkHubOut"],
      ["linkHubOut"],
      ["hubSeriesToChart"],
      ["linkHubOut"]
    ]
  },
