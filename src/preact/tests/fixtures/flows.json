  {
    "id": "chartInject",
    "z": "f100000000000003",
    "type": "inject",
    "name": "Tick",
    "props": [{"p": "payload"}],
    "repeat": "1",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "x": 140,
    "y": 100,
    "wires": [["chartFnSin", "chartFnCos"]]
  },
  {
    "id": "chartFnSin",
    "z": "f100000000000003",
    "type": "function",
    "name": "Sin Series",
    "func": "// Angular format: { update: true, values: { series: STRING, data: {x,y} } }\nconst t = Date.now();\nconst phase = t / 1000;\nconst y = Math.round(50 + 40 * Math.sin(phase));\nmsg.payload = [{ key: 'chartNode', update: true, values: { series: 'Sin', data: { x: t, y: y }, labels: '' } }];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 80,
    "wires": [["chartNode"]]
  },
  {
    "id": "chartFnCos",
    "z": "f100000000000003",
    "type": "function",
    "name": "Cos Series",
    "func": "// Angular format: { update: true, values: { series: STRING, data: {x,y} } }\nconst t = Date.now();\nconst phase = t / 1000;\nconst y = Math.round(50 + 40 * Math.cos(phase));\nmsg.payload = [{ key: 'chartNode', update: true, values: { series: 'Cos', data: { x: t, y: y }, labels: '' } }];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 120,
    "wires": [["chartNode"]]
  },
