  {
    "id": "hubSeriesToChart",
    "z": "f100000000000003",
    "type": "function",
    "name": "Series → Chart",
    "func": "const series = msg.payload;\nconst now = new Date();\nmsg.payload = [{\n  series: [series],\n  data: [[0]],\n  labels: [now.toLocaleTimeString()]\n}];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 300,
    "wires": [["chartNode"]]
  }
